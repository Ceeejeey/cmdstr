# Generated by Cargo
# will have compiled files and executables
debug/
target/

# Remove Cargo.lock from gitignore if creating an executable, leave it for libraries
# More information here https://doc.rust-lang.org/cargo/guide/cargo-toml-vs-cargo-lock.html
# Cargo.lock

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb
*.ilk

# vim/emacs/editors
*.swp
*.swo
*.~undo-tree~
*~

# vscode
.vscode/

# Mac
.DS_Store

# Patching/Backup
*.orig
*.bak

# Debian packaging artifacts (if you build in the tree)
*.deb
*.dsc
*.changes
*.buildinfo
*.build
*.tar.gz
*.tar.xz
*.upload
cmdstr-*/
cmdstr_*/
.pc/
debian/files

# Build logs
buildlog*.txt

# Vendored crate dependencies
vendor/
.cargo/config.toml

# Subcrate vendoring and artifacts
cmd-store/.cargo/
cmd-store/Cargo.lock
cmd-store/debian/files
cmd-store/.pc/
cmd-store/buildlog*.txt
